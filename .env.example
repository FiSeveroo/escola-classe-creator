# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — site key (pública). A secret key NÃO vai aqui:
# ela é cadastrada no Supabase (Authentication → Attack Protection → Captcha).
# Deixe vazio em desenvolvimento para desativar o widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
